# PostgreSQL
DB_USER=tcya_user
DB_PASSWORD=tcya_pass_local

# JWT (cambia esto por una cadena larga y aleatoria en producción)
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga_minimo_256_bits
JWT_EXPIRATION_MS=86400000

